{
  "name": "housing-fund",
  "version": "1.0.0",
  "description": "صندوق السكن — shared housing fund with Firebase real-time sync",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.js",
    "dev": "npm run build && firebase emulators:exec --project demo-housing-fund --only auth,firestore \"node server/index.js\"",
    "test:unit": "node --test \"test/unit/*.test.*\"",
    "test:emulator": "node --test --test-concurrency=1 \"test/emulator/*.test.*\"",
    "test": "npm run build && npm run test:unit && firebase emulators:exec --project demo-housing-fund --only auth,firestore \"npm run test:emulator\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashrafaltiti/Housing-fund.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Ashrafaltiti/Housing-fund/issues"
  },
  "homepage": "https://github.com/Ashrafaltiti/Housing-fund#readme",
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.35.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
